    <!-- MODAL ĐẶT MUA SÁCH -->
    <div class="order-modal-backdrop" id="orderModal">
      <div class="order-modal-card">
        <button class="order-modal-close" id="closeOrderModal" aria-label="Đóng popup">&times;</button>
        <div class="modal-header">
          <h3 class="modal-header-title">ĐẶT MUA NHÀ GIẢ KIM</h3>
          <p class="modal-header-desc">Bản đặc biệt bìa cứng cao cấp &bull; Tặng kèm Bookmark mạ vàng</p>
        </div>
        <form class="order-form" id="bookOrderForm" onsubmit="event.preventDefault(); window.handleOrderSubmit();">
          <div class="form-group">
            <label for="customerName">Họ và tên của bạn</label>
            <input type="text" id="customerName" required placeholder="Ví dụ: Nguyễn Văn A">
          </div>
          <div class="form-group">
            <label for="customerPhone">Số điện thoại nhận hàng</label>
            <input type="tel" id="customerPhone" required placeholder="098x xxx xxx">
          </div>
          <div class="form-group">
            <label for="customerAddress">Địa chỉ giao hàng</label>
            <input type="text" id="customerAddress" required placeholder="Số nhà, đường, phường/xã, quận/huyện...">
          </div>
          <div class="form-group">
            <label for="bookQuantity">Số lượng cuốn</label>
            <select id="bookQuantity" onchange="window.updateOrderPrice(this.value)">
              <option value="1">1 cuốn - 129.000 đ (Bản kỉ niệm cao cấp)</option>
              <option value="2">2 cuốn - 258.000 đ (Freeship toàn quốc)</option>
              <option value="3">3 cuốn - 387.000 đ (Tặng kèm sổ tay lữ hành)</option>
            </select>
          </div>
          <div class="price-summary">
            <span>Tổng thanh toán:</span>
            <span class="price-total" id="orderTotalPrice">129.000 đ</span>
          </div>
          <button type="submit" class="btn-gold submit-order-btn">XÁC NHẬN ĐẶT HÀNG &rarr;</button>
        </form>
      </div>
