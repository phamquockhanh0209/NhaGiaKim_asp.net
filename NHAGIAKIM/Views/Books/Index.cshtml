@model NHAGIAKIM.Models.Book

<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nhà Giả Kim - The Alchemist | Kiệt tác của Paulo Coelho</title>
  <meta name="description"
    content="Khám phá kiệt tác Nhà Giả Kim của Paulo Coelho - cuốn sách kinh điển truyền cảm hứng cho hàng chục triệu độc giả trên toàn thế giới trong hành trình tìm kiếm ước mơ.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="~/css/style.css" />
  <link rel="stylesheet" href="~/css/order.css" />
</head>

<body>

  <header class="site-header" id="mainHeader">
    <div class="container header-container">
      <a href="#hero" class="brand-logo" aria-label="Trang chủ Nhà Giả Kim">
        <div class="brand-icon-wrapper">
          <svg class="brand-icon-svg" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="14" r="5" fill="#C9A050" opacity="0.85" />
            <path d="M4 32L16 16L24 26L36 10L40 32H4Z" stroke="#E4C57C" stroke-width="1.8" stroke-linejoin="round" />
            <path d="M16 16L24 28" stroke="#E4C57C" stroke-width="1.2" stroke-linecap="round" />
          </svg>
        </div>
        <span class="brand-text">Nhà Giả Kim</span>
      </a>

      <nav class="main-nav" id="mainNav">
        <a href="#hero" class="nav-link active">Trang chủ</a>
        <a href="#author" class="nav-link">Tác giả</a>
        <a href="#recognition" class="nav-link">Review</a>
        <a href="#journey" class="nav-link">Hành trình</a>
        <a href="#feedback" class="nav-link">Feedback</a>
      </nav>

      <div class="header-actions">
        <a href="order.html" class="btn-gold header-btn">MUA SÁCH</a>
        <button class="mobile-nav-toggle" id="navToggle" aria-label="Mở menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <section class="hero-section" id="hero">
    <canvas id="alchemyDustCanvas"></canvas>
    <div class="hero-sun-glow"></div>
    <div class="container hero-container">
      <div class="hero-left reveal-fade-left">
        <div class="hero-author-vertical"><span>PAULO COELHO &bull; 1988</span></div>
        <div class="hero-left-content">
          <h1 class="hero-main-title">
            <span>NHÀ</span><span>GIẢ</span><span>KIM</span>
          </h1>
          <p class="hero-quote">Một hành trình đi tìm kho báu, nhưng cuối cùng lại là tìm thấy chính mình.</p>
          <div class="hero-actions">
            <a href="#journey" class="btn-outline-glass">KHÁM PHÁ CUỐN SÁCH &rarr;</a>
            <a href="#purchase" class="btn-gold buy-book-trigger">MUA SÁCH</a>
          </div>
        </div>
      </div>

      <div class="hero-right reveal-fade-right delay-2">
        <div class="hero-stat-item">
          <div class="hero-stat-title">THE ALCHEMIST</div>
          <div class="hero-stat-desc">KIỆT TÁC VĂN HỌC</div>
        </div>
        <div class="hero-stat-item">
          <div class="hero-stat-title">65+ MILLION COPIES</div>
          <div class="hero-stat-desc">BẢN ĐƯỢC BÁN RA</div>
        </div>
        <div class="hero-stat-item">
          <div class="hero-stat-title">TRANSLATED WORLDWIDE</div>
          <div class="hero-stat-desc">HƠN 80 NGÔN NGỮ</div>
        </div>
      </div>
    </div>
  </section>

  <section class="author-section" id="author">
    <div class="container">
      <div class="section-tag theme-light reveal-fade-up">
        <span class="number">01</span><span class="line"></span><span>THE AUTHOR</span>
      </div>
      <div class="author-grid">
        <div class="author-portrait-wrapper reveal-fade-left">
          <div class="author-portrait-frame image-placeholder">
                        <img src="~/img/sach.png" alt="Chân dung nhà văn Paulo Coelho" id="authorImage"
              onerror="this.style.display='none'; document.getElementById('authorFallback').style.display='flex';" />
            <div class="author-portrait-fallback" id="authorFallback" style="display:none;">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
              </svg>
              <div style="font-family:var(--font-heading-royal);font-size:0.95rem;margin-bottom:6px;">PAULO COELHO</div>
            </div>
          </div>
          <div class="author-signature">
            <div class="author-signature-text">Paulo Coelho</div>
          </div>
        </div>

        <div class="author-bio reveal-fade-up delay-1">
          <h2 class="author-name">PAULO COELHO</h2>
          <span class="author-sub">Nhà văn Brazil</span>
          <div class="author-desc">
            <p>Paulo Coelho sinh năm 1947 tại Rio de Janeiro, Brazil. Ông là một trong những nhà văn có tầm ảnh hưởng
              lớn nhất thế giới, với những tác phẩm truyền cảm hứng về hành trình, ước mơ và sự tìm kiếm ý nghĩa của
              cuộc sống. <em>Nhà Giả Kim</em> là tác phẩm nổi tiếng nhất của ông, được dịch ra hơn 80 ngôn ngữ và bán
              hơn 65 triệu bản trên toàn thế giới.</p>
          </div>
        </div>

        <div class="author-specs-card reveal-fade-right delay-2">
          <div class="spec-row"><span class="spec-label">Tác giả</span><span class="spec-value">Paulo Coelho</span>
          </div>
          <div class="spec-row"><span class="spec-label">Năm xuất bản</span><span class="spec-value">1988</span></div>
          <div class="spec-row"><span class="spec-label">Thể loại</span><span class="spec-value">Tiểu thuyết</span>
          </div>
          <div class="spec-row"><span class="spec-label">Số trang</span><span class="spec-value">163</span></div>
          <div class="spec-row"><span class="spec-label">Ngôn ngữ</span><span class="spec-value">Tiếng Anh<small>(và
                nhiều ngôn ngữ khác)</small></span></div>
        </div>
      </div>
    </div>
    <div class="author-landscape-bg">
      <svg viewBox="0 0 600 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 190L120 110L200 150L310 70L420 160L520 80L600 190" stroke="#8E7863" stroke-width="1.5"
          stroke-dasharray="3 3" />
        <path d="M50 190L160 130L260 170L380 90L480 180L550 140L600 190" stroke="#C9A050" stroke-width="1"
          opacity="0.6" />
        <path d="M180 190L230 165L290 185L350 145L400 190" stroke="#7D7162" stroke-width="1" />
      </svg>
    </div>
  </section>

  <section class="recognition-section" id="recognition">
    <div class="container">
      <div class="section-tag theme-light reveal-fade-up">
        <span class="number">02</span><span class="line"></span><span>RECOGNITION</span>
      </div>
      <div class="recognition-grid">
        <div class="recognition-card reveal-fade-up delay-1">
          <div class="press-logo"><span class="press-logo-nyt">The New York Times</span></div>
          <p class="press-quote">"An international literary phenomenon"</p>
        </div>
        <div class="recognition-card reveal-fade-up delay-2">
          <div class="press-logo">
            <div class="press-logo-bbc"><span>B</span><span>B</span><span>C</span></div>
          </div>
          <p class="press-quote">"Translated around the world"</p>
        </div>
        <div class="recognition-card reveal-fade-up delay-3">
          <div class="press-logo"><span class="press-logo-guardian">The Guardian</span></div>
          <p class="press-quote">"Loved by millions of readers"</p>
        </div>
        <div class="recognition-card reveal-fade-up delay-4">
          <div class="press-logo"><span class="press-logo-time">TIME</span></div>
          <p class="press-quote">"A modern classic"</p>
        </div>
        <div class="recognition-card reveal-fade-up delay-5">
          <div class="press-logo"><span class="press-logo-wapo">The Washington Post</span></div>
          <p class="press-quote">"A book for every generation"</p>
        </div>
      </div>
    </div>
  </section>

  <section class="journey-section" id="journey">
    <div class="container journey-container">
      <div class="section-tag theme-dark reveal-fade-up">
        <span class="number">03</span><span class="line"></span><span>THE JOURNEY</span>
      </div>
      <div class="journey-quotes-stage">
        <div class="journey-phrase journey-phrase-1 reveal-fade-left delay-1">LẮNG NGHE<br>TRÁI TIM</div>
        <div class="journey-phrase journey-phrase-2 reveal-fade-left delay-2">DÁM THEO ĐUỔI ƯỚC MƠ</div>
        <div class="journey-phrase journey-phrase-3 reveal-fade-right delay-2">HÀNH TRÌNH QUAN TRỌNG HƠN ĐÍCH ĐẾN</div>
      </div>
      <div class="journey-bottom-summary reveal-fade-up delay-3">
        <p class="journey-summary-text"><em>Nhà Giả Kim</em> không chỉ là câu chuyện về một chàng trai trẻ đi tìm kho
          báu, mà còn là hành trình khám phá bản thân, về những giấc mơ, tình yêu, và những bài học quý giá mà cuộc sống
          mang lại.</p>
        <div class="journey-bottom-buttons">
          <a href="#author" class="btn-dark">ĐỌC THỬ &rarr;</a>
          <a href="#purchase" class="btn-gold buy-book-trigger">MUA SÁCH &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="readers-section" id="readers">
    <div class="container">
      <div class="section-tag theme-light reveal-fade-up">
        <span class="number">04</span><span class="line"></span><span>READERS</span>
      </div>
      <div class="readers-grid">
        <div class="reader-reviews-col">
          <div class="reader-card reveal-fade-up delay-1">
            <div class="reader-header">
              <div class="reader-avatar">
                <img src="~/img/anh2.png" alt="Minh Anh"
                  onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'%23c9a050\'><circle cx=\'12\' cy=\'8\' r=\'4\'/><path d=\'M12 14c-6 0-8 3-8 5v1h16v-1c0-2-2-5-8-5z\'/></svg>'" />
              </div>
              <div class="reader-info"><span class="reader-name">Minh Anh</span><span
                  class="reader-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span></div>
            </div>
            <p class="reader-quote">"Một cuốn sách tuyệt vời! Đọc xong mình thấy như được tiếp thêm động lực để theo
              đuổi ước mơ của bản thân."</p>
          </div>
          <div class="reader-card reveal-fade-up delay-2">
            <div class="reader-header">
              <div class="reader-avatar">
                <img src="~/img/anh2.png" alt="Thu Phương"
                  onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'%23c9a050\'><circle cx=\'12\' cy=\'8\' r=\'4\'/><path d=\'M12 14c-6 0-8 3-8 5v1h16v-1c0-2-2-5-8-5z\'/></svg>'" />
              </div>
              <div class="reader-info"><span class="reader-name">Thu Phương</span><span
                  class="reader-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span></div>
            </div>
            <p class="reader-quote">"Câu chuyện giản dị nhưng sâu sắc. Đọc Nhà Giả Kim, tôi học được cách lắng nghe trái
              tim mình."</p>
          </div>
        </div>

        <div class="readers-center-summary reveal-zoom-in delay-2">
          <blockquote class="readers-highlight-quote">"Một cuốn sách nhỏ nhưng chứa đựng cả một thế giới lớn."
          </blockquote>
          <div class="readers-score-wrapper">
            <div class="readers-score-number">4.8 <span>/ 5</span></div>
            <div class="readers-score-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          </div>
          <div class="rating-breakdown-table" id="ratingBreakdown">
            <div class="rating-bar-row"><span class="rating-star-label">5 sao</span>
              <div class="rating-bar-track">
                <div class="rating-bar-fill" data-percent="78"></div>
              </div><span class="rating-percent-label">78%</span>
            </div>
            <div class="rating-bar-row"><span class="rating-star-label">4 sao</span>
              <div class="rating-bar-track">
                <div class="rating-bar-fill" data-percent="15"></div>
              </div><span class="rating-percent-label">15%</span>
            </div>
            <div class="rating-bar-row"><span class="rating-star-label">3 sao</span>
              <div class="rating-bar-track">
                <div class="rating-bar-fill" data-percent="5"></div>
              </div><span class="rating-percent-label">5%</span>
            </div>
            <div class="rating-bar-row"><span class="rating-star-label">2 sao</span>
              <div class="rating-bar-track">
                <div class="rating-bar-fill" data-percent="1"></div>
              </div><span class="rating-percent-label">1%</span>
            </div>
            <div class="rating-bar-row"><span class="rating-star-label">1 sao</span>
              <div class="rating-bar-track">
                <div class="rating-bar-fill" data-percent="1"></div>
              </div><span class="rating-percent-label">1%</span>
            </div>
          </div>
        </div>

        <div class="reader-reviews-col">
          <div class="reader-card reveal-fade-up delay-1">
            <div class="reader-header">
              <div class="reader-avatar">
                <img src="~/img/anh2.png" alt="Hoàng Nam"
                  onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'%23c9a050\'><circle cx=\'12\' cy=\'8\' r=\'4\'/><path d=\'M12 14c-6 0-8 3-8 5v1h16v-1c0-2-2-5-8-5z\'/></svg>'" />
              </div>
              <div class="reader-info"><span class="reader-name">Hoàng Nam</span><span
                  class="reader-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span></div>
            </div>
            <p class="reader-quote">"Một hành trình đầy cảm hứng. Cuốn sách khiến mình suy nghĩ nhiều hơn về cuộc sống."
            </p>
          </div>
          <div class="reader-card reveal-fade-up delay-2">
            <div class="reader-header">
              <div class="reader-avatar">
                <img src="~/img/anh2.png" alt="Lan Anh"
                  onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' fill=\'%23c9a050\'><circle cx=\'12\' cy=\'8\' r=\'4\'/><path d=\'M12 14c-6 0-8 3-8 5v1h16v-1c0-2-2-5-8-5z\'/></svg>'" />
              </div>
              <div class="reader-info"><span class="reader-name">Lan Anh</span><span
                  class="reader-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span></div>
            </div>
            <p class="reader-quote">"Tuyệt vời! Một trong những cuốn sách hay nhất mà mình từng đọc. Rất đáng để trải
              nghiệm."</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================================
       FEEDBACK SECTION — id="feedback"
        <!-- Dữ liệu mẫu để test UI. Sau này thay bằng foreach (var fb in Model.Feedbacks) -->
       Form POST tới: /Feedback/Create
       Controller nhận: FeedbackCreateViewModel { CustomerName, Email, StarRating, Content }
       ============================================================ -->
  <section class="feedback-section" id="feedback">
    <div class="container">
      <div class="section-tag theme-light reveal-fade-up">
        <span class="number">05</span><span class="line"></span><span>FEEDBACK</span>
      </div>

      <div class="feedback-layout">

        <!-- DANH SÁCH FEEDBAC Sau này replace bằng Razor foreach (var fb in Model.Feedbacks) -->
        <div class="feedback-list" id="feedbackList" aria-label="Danh sách đánh giá của độc giả">

          <!-- feedback-card map với: FeedbackViewModel { Id, CustomerName, Content, StarRating, CreatedAt } -->
          <article class="feedback-card reveal-fade-up delay-1" data-feedback-id="1">
            <div class="feedback-card-header">
              <div class="feedback-avatar" aria-hidden="true">MA</div>
              <div class="feedback-card-meta">
                <span class="feedback-customer-name">Minh Anh</span>
                <div class="feedback-stars" aria-label="5 sao">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
              </div>
              <time class="feedback-date" datetime="2026-09-15">15/09/2026</time>
            </div>
            <p class="feedback-content">&ldquo;Nhà Giả Kim thực sự là một tuyệt phẩm. Cuốn sách giúp tôi tìm lại động lực và ý chí theo đuổi ước mơ của mình.&rdquo;</p>
          </article>

          <article class="feedback-card reveal-fade-up delay-2" data-feedback-id="2">
            <div class="feedback-card-header">
              <div class="feedback-avatar" aria-hidden="true">HN</div>
              <div class="feedback-card-meta">
                <span class="feedback-customer-name">Hoàng Nam</span>
                <div class="feedback-stars" aria-label="4 sao">&#9733;&#9733;&#9733;&#9733;&#9734;</div>
              </div>
              <time class="feedback-date" datetime="2026-09-22">22/09/2026</time>
            </div>
            <p class="feedback-content">&ldquo;Văn phong đẹp, ý nghĩa sâu sắc. Mỗi trang sách là một bài học quý giá về hành trình tìm kiếm bản thân.&rdquo;</p>
          </article>

          <article class="feedback-card reveal-fade-up delay-3" data-feedback-id="3">
            <div class="feedback-card-header">
              <div class="feedback-avatar" aria-hidden="true">TP</div>
              <div class="feedback-card-meta">
                <span class="feedback-customer-name">Thu Phương</span>
                <div class="feedback-stars" aria-label="5 sao">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
              </div>
              <time class="feedback-date" datetime="2026-10-01">01/10/2026</time>
            </div>
            <p class="feedback-content">&ldquo;Đọc lần đầu năm 2020, đọc lại vào 2026 — mỗi lần đọc lại tôi đều cảm nhận được điều gì đó mới. Đây là cuốn sách tôi sẽ giữ suốt đời.&rdquo;</p>
          </article>

        </div>
        <!-- end #feedbackList -->

        <!-- FORM GỬI FEEDBACK
             Cấu trúc sẵn sàng để [HttpPost] Controller action nhận bằng FeedbackCreateViewModel
             ASP.NET Core: asp-action="Create" asp-controller="Feedback" -->
        <div class="feedback-form-wrapper reveal-fade-right delay-2">
          <h3 class="feedback-form-title">Chia sẻ cảm nhận của bạn</h3>
          <p class="feedback-form-subtitle">Đánh giá của bạn giúp chúng tôi lan toả tình yêu sách đến nhiều người hơn.</p>

          <!-- Html.AntiForgeryToken() -->
          <form method="post"
                action="/Feedback/Create"
                id="feedbackForm"
                class="feedback-form"
                novalidate>

            <div class="form-group">
              <label for="feedbackCustomerName">Họ và tên <span class="required-mark" aria-hidden="true">*</span></label>
              <input type="text"
                     id="feedbackCustomerName"
                     name="CustomerName"
                     placeholder="Ví dụ: Nguyễn Thị Lan"
                     required
                     autocomplete="name">
            </div>

            <div class="form-group">
              <label for="feedbackEmail">Email <span class="required-mark" aria-hidden="true">*</span></label>
              <input type="email"
                     id="feedbackEmail"
                     name="Email"
                     placeholder="email@example.com"
                     required
                     autocomplete="email">
            </div>

            <!-- Star Picker — giá trị thực map với: int StarRating -->
            <div class="form-group">
              <label>Đánh giá số sao <span class="required-mark" aria-hidden="true">*</span></label>
              <div class="star-picker" id="starPicker" role="radiogroup" aria-label="Chọn số sao">
                <button type="button" class="star-btn" data-value="1" aria-label="1 sao">&#9733;</button>
                <button type="button" class="star-btn" data-value="2" aria-label="2 sao">&#9733;</button>
                <button type="button" class="star-btn" data-value="3" aria-label="3 sao">&#9733;</button>
                <button type="button" class="star-btn" data-value="4" aria-label="4 sao">&#9733;</button>
                <button type="button" class="star-btn active" data-value="5" aria-label="5 sao">&#9733;</button>
              </div>
              <input type="hidden" id="feedbackStarRating" name="StarRating" value="5">
            </div>

            <div class="form-group">
              <label for="feedbackContent">Nội dung đánh giá <span class="required-mark" aria-hidden="true">*</span></label>
              <textarea id="feedbackContent"
                        name="Content"
                        rows="4"
                        placeholder="Chia sẻ cảm nhận của bạn về cuốn sách..."
                        required></textarea>
            </div>

            <button type="submit" class="btn-gold feedback-submit-btn">
              Gửi đánh giá &rarr;
            </button>

          </form>

          <!-- Vùng hiển thị thông báo validation (frontend) — sau này thay bằng Html.ValidationSummary() -->
          <div class="feedback-form-message" id="feedbackFormMessage" aria-live="polite" hidden></div>
        </div>
        <!-- end .feedback-form-wrapper -->

      </div>
      <!-- end .feedback-layout -->
    </div>
  </section>

  <footer class="site-footer" id="purchase">
    <div class="container">
      <div class="footer-top-grid">
        <div class="footer-left-col reveal-fade-left">
